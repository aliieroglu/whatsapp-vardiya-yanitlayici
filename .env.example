# Bu dosyayı .env olarak kopyala; gerçek grup ve gönderen kimliklerini GitHub'a koyma.
MODE=dry-run
SHIFT_GROUP_ID=123456789012345678@g.us
ALLOWED_SENDERS=
REPLY_TEXT=ok
MAX_AGE_SECONDS=60
COOLDOWN_SECONDS=180
# Sistem Chrome'u kullanıyorsan (Linux örneği):
CHROME_PATH=/usr/bin/google-chrome
# Örnek: CALL_PHRASES=kimler gelebilir|gelebilecek|personel lazım
